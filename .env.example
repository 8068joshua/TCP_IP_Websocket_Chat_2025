# Core TCP server
TCP_HOST=0.0.0.0
TCP_PORT=9000

# Web gateway
WEB_HOST=0.0.0.0
WEB_PORT=8080

# Clients / gateway -> core
CORE_HOST=127.0.0.1
CORE_PORT=9000
CORE_CA_FILE=certs/server.crt

# TLS server certificate
CERT_FILE=certs/server.crt
KEY_FILE=certs/server.key

# Change this before use.
# Example generation:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SERVICE_API_KEY=CHANGE_ME_TO_A_LONG_RANDOM_VALUE

# Persistence / logs
DB_FILE=data/localops.db
LOG_FILE=logs/server.log

# Heartbeat
HEARTBEAT_INTERVAL=5
HEARTBEAT_TIMEOUT=15

# Device agent
DEVICE_ID=
DEVICE_STATUS_INTERVAL=10
